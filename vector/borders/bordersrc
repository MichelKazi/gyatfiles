#!/bin/bash
# vector bordersrc — window borders follow the channel logic.
# Default active = cyan (the "focused" channel); BORDERS_ACTIVE_COLOR can
# retune per-context (red = danger session, amber = machine focus, etc).

CRIMSON="0xffff5d73"
GREEN="0xff34d399"
BLUE="0xff60a5fa"
CYAN="0xff22d3ee"
AMBER="0xfff0b429"
EMBER="0xffff8f5e"
PINK="0xffe879a0"
VIOLET="0xffb18aff"
DEFAULT="0xff22d3ee"

case "$BORDERS_ACTIVE_COLOR" in
"red" | "crimson") ACTIVE_COLOR=$CRIMSON ;;
"green")           ACTIVE_COLOR=$GREEN ;;
"blue")            ACTIVE_COLOR=$BLUE ;;
"yellow" | "amber") ACTIVE_COLOR=$AMBER ;;
"orange" | "ember") ACTIVE_COLOR=$EMBER ;;
"pink")            ACTIVE_COLOR=$PINK ;;
"violet" | "purple") ACTIVE_COLOR=$VIOLET ;;
"cyan")            ACTIVE_COLOR=$CYAN ;;
*)                 ACTIVE_COLOR=$DEFAULT ;;
esac

# Inactive = grid hairline
INACTIVE_COLOR="0xff1a2332"

borders active_color=$ACTIVE_COLOR inactive_color=$INACTIVE_COLOR width=9
