[[ "$OSTYPE" == darwin* ]] || return

## Directories
alias downloads="cd ~/Downloads"
alias docs="cd ~/Documents"
alias projects="cd ~/projects"
alias gyatfiles="cd ~/gyatfiles"
alias ..="cd .."
alias icloud="cd ~/Library/Mobile\ Documents/com~apple~CloudDocs/"


# Misc
alias skhdrc="vim ~/gyatfiles/skhd/.config/skhd"
alias yabairc="vim ~/gyatfiles/yabai/.config/yabai"
alias sketchybarrc="vim ~/gyatfiles/yabai/.config/yabai"
alias ckitty="vim ~/gyatfiles/kitty/.config/kitty/kitty.conf"
alias vrc="vim ~/.config/nvim/"
alias wmrc="vim ~/.config/aerospace"
alias weztermrc="vim ~/.config/wezterm"
alias ghosttyrc="vim ~/.config/ghostty/"
alias ctmux="vim ~/.tmux.conf"
alias zconf="vim ~/.config/gyatfiles/zsh"
alias pls="sudo"
alias czsh="vim ~/.oh-my-zsh/custom"
alias szsh="source ~/.zshrc"
alias rm='echo "Are you sure? Use rip or /bin/rm"'

## Docker
alias dockerfile="vim Dockerfile"
alias dockercompose="vim docker-compose.yml"
alias dockompose="docker-compose"

## Misc Shortcuts
alias vim="nvim"
alias copydir="pwd | xclip"
alias javacall="javac *.java"
alias py3="python3"
alias ls="lsd"
alias back="cd -"
alias nv="nvim"
alias v="vim"
alias readme="vim README.md"

alias paas="~/strava/configuration/mesos/tools/paasage"
alias paasage='paas'
alias vpn='/Applications/Pritunl.app/Contents/Resources/pritunl-client'
alias livegrep='docker run --rm docker.strava.com/strava/livegrep-cli "$@"'
