<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.kazi.syncbrewpackages</string>
  <key>ProgramArguments</key><array>
    <string>/bin/zsh</string><string>-lc</string>
    <string>export PATH="/opt/homebrew/bin:/usr/local/bin:$PATH"; "$HOME/gyatfiles/scripts/sync-installed-packages.sh" --brew-only</string>
  </array>
  <key>StartInterval</key><integer>300</integer>
  <key>RunAtLoad</key><true/>
  <key>StandardOutPath</key><string>/tmp/syncbrewpackages.log</string>
  <key>StandardErrorPath</key><string>/tmp/syncbrewpackages.err</string>
</dict></plist>
