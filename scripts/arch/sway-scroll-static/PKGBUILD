prepare() {
  local fallback_dir="$srcdir/scroll-$pkgver/subprojects/wlroots/subprojects"

  cp -aT "$srcdir/wayland-1.24.0" "$fallback_dir/wayland"
  cp -aT "$srcdir/wayland-protocols-1.48" "$fallback_dir/wayland-protocols"
}

build() {
  arch-meson "$srcdir/build" "$srcdir/scroll-$pkgver" \
    --force-fallback-for=wayland,wayland-protocols \
    -Db_ndebug=true \
    -Dsd-bus-provider=libsystemd \
    -Dwayland:default_library=static \
    -Dwayland:documentation=false \
    -Dwayland:tests=false \
    -Dwayland-protocols:tests=false \
    -Dwlroots:werror=false \
    -Dwerror=false
  meson compile -C "$srcdir/build"
}

check() {
  local binary
  local binaries=(
    'sway/scroll'
    'swaybar/scrollbar'
    'swaymsg/scrollmsg'
    'swaynag/scrollnag'
  )

  [[ -x "$srcdir/build/sway/scroll" ]] || {
    printf 'Missing expected Scroll binary\n' >&2
    return 1
  }

  for binary in "${binaries[@]}"; do
    [[ -x "$srcdir/build/$binary" ]] || continue
    if readelf -d "$srcdir/build/$binary" |
      awk '/NEEDED/ && /libwayland-[[:alnum:]_-]+\.so/ { found=1 } END { exit !found }'; then
      printf 'Dynamic Wayland dependency found in %s\n' "$binary" >&2
      return 1
    fi
  done
}

package() {
  local leaked_path
  local forbidden_paths=(
    "$pkgdir/usr/bin/wayland-scanner"
    "$pkgdir/usr/include/wayland*.h"
    "$pkgdir/usr/lib/libwayland*"
    "$pkgdir/usr/lib/pkgconfig/wayland*.pc"
    "$pkgdir/usr/share/wayland"
    "$pkgdir/usr/share/wayland-protocols"
  )

  meson install -C "$srcdir/build" --destdir "$pkgdir" --skip-subprojects
  install -Dm644 "$srcdir/scroll-$pkgver/LICENSE" \
    "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$srcdir/scroll-$pkgver/README.md" \
    "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 "$srcdir/50-systemd-user.conf" \
    "$pkgdir/etc/scroll/config.d/50-systemd-user.conf"
  install -Dm644 "$srcdir/scroll-portals.conf" \
    "$pkgdir/usr/share/xdg-desktop-portal/scroll-portals.conf"

  for leaked_path in "${forbidden_paths[@]}"; do
    if compgen -G "$leaked_path" >/dev/null; then
      printf 'Vendored Wayland install artifact found: %s\n' "$leaked_path" >&2
      return 1
    fi
  done
}
